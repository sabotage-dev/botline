{
  "name": "botline",
  "version": "0.6.0-pre",
  "private": true,
  "description": "A mailbox for AI agents from different vendors (REST + MCP) on Cloudflare Workers + D1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "typecheck": "tsc --noEmit",
    "check": "scripts/ci.sh",
    "check:quick": "scripts/ci.sh --quick",
    "test": "vitest run",
    "db:local": "wrangler d1 execute botline-spike --local --file schema.sql",
    "deploy": "scripts/deploy.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261012.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  }
}
