// botline v0.5-pre. Secrets (never in this file): DOORBELL_MASTER_KEY, RESEND_API_KEY (waitlist mail), TURNSTILE_SECRET
// (waitlist bot check), ECHO_SECRET (check.sh only) via `npx wrangler secret put <NAME>`; locally via .dev.vars (gitignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Outbound doorbell fetches go over the public internet, so a ring can reach another
  // *.workers.dev URL on the same account (and check.sh's self-test: <base>/v1/_echo).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "botline-spike",
      // Remote D1 created 2026-10-13 (`wrangler d1 create botline-spike`). Local dev (--local)
      // keeps its own SQLite copy under .wrangler/state.
      "database_id": "3a3560f7-c618-4714-ac12-8cf567366281"
    }
  ],
  // File bytes (v0.2). Create the bucket once: `npx wrangler r2 bucket create botline-files`. To run without files,
  // delete this entry: file routes then answer 501 files_not_configured and everything else works as before.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "botline-files" }],
  // Daily file retention: deletes expired and abandoned files in bounded passes (src/files.ts sweep). Counts toward the
  // account's Cron Trigger limit (Workers Free allows only a few per account); without it, expired files stay unreadable
  // but their bytes and quota are not reclaimed.
  "triggers": { "crons": ["23 4 * * *"] },
  // Re-rings (v0.4, src/doorbell.ts): a doorbell that is busy (the agent is mid-run) or failed rings again by itself, through
  // this queue (Workers Free includes 10,000 queue operations a day). Create it once: `npx wrangler queues create
  // botline-rering`. To run without it, delete this entry: a busy ring then counts as a failure and nothing re-rings after
  // a backoff (v0.3 behaviour). scripts/check.sh runs against a dev Worker WITHOUT it (see its header).
  "queues": {
    "producers": [{ "binding": "RERING", "queue": "botline-rering" }],
    // retries only after an error (a failed ring is not an error): the re-ring token survives it (src/doorbell.ts rering)
    "consumers": [{ "queue": "botline-rering", "max_batch_size": 10, "max_retries": 3 }]
  },
  "vars": {
    // Extra Origins allowed on /mcp besides our own (comma-separated). Empty = own origin only.
    "MCP_ALLOWED_ORIGINS": "",
    // Hostnames a generic_webhook doorbell may ring (comma-separated). Empty = generic webhooks are off.
    // check.sh rings <base>/v1/_echo, so a deployment that runs it lists its own host here.
    "WEBHOOK_ALLOWED_HOSTS": "",
    // Waitlist mail sender, e.g. "botline <hello@your.domain>" (a Resend-verified domain). Empty, or no RESEND_API_KEY
    // secret = dev mode: the confirm/delete links go to the Worker log instead of a mail.
    "WAITLIST_FROM": "", // empty = the waitlist pages and POST /v1/waitlist are off (self-host default)
    // https:// link to the source repository, shown on /waitlist and in its mail. Empty = no link.
    "REPO_URL": "",
    // Confirmation mails per UTC day, all addresses together (Resend's free tier sends 100/day). Past it: no mail, 202.
    "WAITLIST_MAIL_CAP_PER_DAY": "80",
    // Cloudflare Turnstile site key for /waitlist. Turnstile is on only when this AND the TURNSTILE_SECRET secret are set.
    "TURNSTILE_SITE_KEY": "",
    // Files: largest REST upload (MB, under the 100 MB request body), largest MCP upload/inline read (KB), the workspace's
    // total stored bytes (MB) and file count, and how long an unattached upload lives (hours).
    "FILE_MAX_MB": "25",
    "FILE_MCP_MAX_KB": "256",
    "WORKSPACE_FILE_QUOTA_MB": "1024",
    "WORKSPACE_FILE_MAX_COUNT": "1000",
    "FILE_UNATTACHED_HOURS": "24"
  }
}
